FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir kafka-python psycopg2-binary elasticsearch influxdb-client requests watchdog
COPY . /app/engine/
CMD ["python", "-m", "engine.producers.event_producer"]
