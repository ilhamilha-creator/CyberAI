# ============================================================
# CyberAI-Expert v8.0 — Environment Variables
# Ubuntu Server 22.04 + Docker Compose
# ============================================================

# --- Project ---
COMPOSE_PROJECT_NAME=cyberai
PROJECT_VERSION=8.0

# --- GNS3 Integration ---
GNS3_SERVER_IP=192.168.1.100
GNS3_MIRROR_INTERFACE=eth1
ZEEK_CAPTURE_INTERFACE=eth1
SURICATA_CAPTURE_INTERFACE=eth1

# --- PostgreSQL ---
POSTGRES_USER=cyberai
POSTGRES_PASSWORD=CyberAI_S3cur3_2024!
POSTGRES_DB=cyberai_soc
POSTGRES_PORT=5432

# --- Elasticsearch ---
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_PORT=9200

# --- Kafka ---
KAFKA_BROKER=kafka:29092
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# --- InfluxDB ---
INFLUXDB_ADMIN_USER=cyberai
INFLUXDB_ADMIN_PASSWORD=InfluxDB_CyberAI_2024!
INFLUXDB_ORG=cyberai-org
INFLUXDB_BUCKET=cyberai-metrics
INFLUXDB_ADMIN_TOKEN=cyberai-influxdb-super-secret-token-v8-2024
INFLUXDB_PORT=8086

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=Redis_CyberAI_2024!

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CyberAI_Grafana_2024!
GF_PORT=3000

# --- MinIO ---
MINIO_ROOT_USER=cyberai-minio
MINIO_ROOT_PASSWORD=MinIO_CyberAI_S3cure_2024!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MLflow ---
MLFLOW_PORT=5050
MLFLOW_BACKEND_STORE=postgresql://cyberai:CyberAI_S3cur3_2024!@postgres:5432/cyberai_soc
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
AWS_ACCESS_KEY_ID=cyberai-minio
AWS_SECRET_ACCESS_KEY=MinIO_CyberAI_S3cure_2024!

# --- FastAPI Backend ---
BACKEND_PORT=8000
SECRET_KEY=cyberai-jwt-secret-key-ultra-secure-v8-2024-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=12
API_KEY_ADMIN=cyberai-admin-key-v8-2024
API_KEY_ANALYST=cyberai-analyst-key-v8-2024
CORS_ORIGINS=http://localhost:3001,http://localhost:80,http://localhost

# --- Celery ---
CELERY_BROKER_URL=redis://:Redis_CyberAI_2024!@redis:6379/1
CELERY_RESULT_BACKEND=redis://:Redis_CyberAI_2024!@redis:6379/2

# --- React Frontend ---
FRONTEND_PORT=3001
REACT_APP_API_URL=http://localhost/api/v1
REACT_APP_WS_URL=ws://localhost/ws

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Superset ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=cyberai-superset-secret-key-v8-2024
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CyberAI_Superset_2024!

# --- Nginx ---
NGINX_PORT=80
NGINX_SSL_PORT=443

# --- Network ---
CYBERAI_SUBNET=172.28.0.0/16

# --- Datasets ---
DATASET_DIR=/app/datasets
USE_PUBLIC_DATASETS=true
SYNTHETIC_FALLBACK=true
